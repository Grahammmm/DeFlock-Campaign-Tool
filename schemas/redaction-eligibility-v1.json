{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_sha256",
    "proposal_sha256",
    "derivative_sha256",
    "derivative_path",
    "signed_by",
    "signed_at",
    "applied_at"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "document_id": {"pattern": "[A-Za-z0-9_-]{1,128}", "type": "string"},
    "source_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
    "proposal_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
    "derivative_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
    "derivative_path": {"minLength": 1, "type": "string"},
    "signed_by": {"minLength": 1, "type": "string"},
    "signed_at": {"pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", "type": "string"},
    "applied_at": {"pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", "type": "string"}
  }
}
