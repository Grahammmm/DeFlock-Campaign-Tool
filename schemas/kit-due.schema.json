{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/kit-due.schema.json",
  "title": "kit-due",
  "description": "Printed by `kit-due` (campaign_tool.kit_track.due): one JSON document on stdout, read-only. open lists unanswered, unclosed requests with a state; answered lists requests with a determination, produced or denied step; stated_passed lists answered requests whose own stated production date has passed; closed requests are left out. The counts past_due, stated_date_passed, installment_passed and waiting_on_you are totals of the lists above (exit 3 when past_due + stated_date_passed + installment_passed is above zero). since and note appear only on an open row whose state is waiting_on_you. received_on, receipt_evidence and (on answered and stated_passed rows) note appear only for a request whose agency receipt was recorded (kit-received); its note reads 'counted from receipt D (KIND)'. An open row with kind extension and state stated_extension_date_passed (note 'stated extension date passed', due = the agency's own stated determination dispatch date, optional with_extension = the provisional extended date) appears only while no determination, produced or denied step is recorded; extension_date_passed counts those rows, appears only when a request recorded such a date, and (unlike past_due) is its own exit 3 trigger. Dates are provisional reminders, not legal due dates. Nothing is sent or published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of", "law_package_status", "open", "answered", "past_due", "stated_passed",
               "stated_date_passed", "installment_passed", "waiting_on_you", "note"],
  "properties": {
    "as_of": {"$ref": "#/$defs/date"},
    "law_package_status": {"enum": ["draft", "reviewed", "missing"]},
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agency_id", "request", "name", "sent_on", "reference", "due", "days", "state"],
        "properties": {
          "agency_id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "name": {"type": ["string", "null"]},
          "sent_on": {"$ref": "#/$defs/date"},
          "reference": {"type": ["string", "null"]},
          "due": {"$ref": "#/$defs/date_or_null"},
          "days": {"type": ["integer", "null"]},
          "state": {
            "enum": ["waiting_on_you", "producing", "installment_passed", "no_law_package", "past_due",
                     "due_today", "upcoming", "download_pending", "download_expired", "stated_extension_date_passed"]
          },
          "kind": {"enum": ["download", "extension"]},
          "with_extension": {"$ref": "#/$defs/date"},
          "produced_on": {"$ref": "#/$defs/date"},
          "since": {"$ref": "#/$defs/date"},
          "note": {"type": "string", "minLength": 1},
          "received_on": {"$ref": "#/$defs/date"},
          "receipt_evidence": {"$ref": "#/$defs/receipt_evidence"}
        }
      }
    },
    "answered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agency_id", "request", "name", "sent_on", "reference", "last_step"],
        "properties": {
          "agency_id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "name": {"type": ["string", "null"]},
          "sent_on": {"$ref": "#/$defs/date"},
          "reference": {"type": ["string", "null"]},
          "note": {"type": "string", "minLength": 1},
          "received_on": {"$ref": "#/$defs/date"},
          "receipt_evidence": {"$ref": "#/$defs/receipt_evidence"},
          "last_step": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["on", "kind"],
            "properties": {
              "on": {"$ref": "#/$defs/date_or_null"},
              "kind": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "past_due": {"type": "integer", "minimum": 0},
    "stated_passed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agency_id", "request", "name", "sent_on", "reference", "state", "stated", "days"],
        "properties": {
          "agency_id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "name": {"type": ["string", "null"]},
          "sent_on": {"$ref": "#/$defs/date"},
          "reference": {"type": ["string", "null"]},
          "state": {"const": "stated_date_passed"},
          "stated": {"$ref": "#/$defs/date"},
          "days": {"type": "integer", "minimum": 1},
          "note": {"type": "string", "minLength": 1},
          "received_on": {"$ref": "#/$defs/date"},
          "receipt_evidence": {"$ref": "#/$defs/receipt_evidence"}
        }
      }
    },
    "stated_date_passed": {"type": "integer", "minimum": 0},
    "installment_passed": {"type": "integer", "minimum": 0},
    "waiting_on_you": {"type": "integer", "minimum": 0},
    "download_expired": {"type": "integer", "minimum": 0},
    "extension_date_passed": {"type": "integer", "minimum": 0},
    "note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "receipt_evidence": {"enum": ["portal", "acknowledgement", "return_receipt", "other"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_or_null": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
