{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Grahammmm/DeFlock-Campaign-Tool/main/schemas/suspected-locations-open-data.schema.json",
  "title": "Document-predicted suspected locations, not confirmed cameras",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_from", "notice", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_from": {"type": "string", "const": "content/suspected-locations.json"},
    "notice": {"type": "string", "const": "A suspected location is predicted by a document. It is not a confirmed camera."},
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "place_label", "latitude", "longitude", "source_kind", "source", "as_of"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "place_label": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?=.*\\S)[^<>\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90, "multipleOf": 0.0001},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180, "multipleOf": 0.0001},
          "source_kind": {"type": "string", "enum": ["records", "permit", "dig_ticket", "contract", "council_item", "other"]},
          "source": {"type": "string", "maxLength": 500, "pattern": "^(?:[0-9a-f]{12}|https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:[/?#][A-Za-z0-9./:?&=%_+#~-]*)?)$"},
          "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date"},
          "agency_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
