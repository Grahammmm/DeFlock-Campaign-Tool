{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jurisdiction law package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdiction",
    "status",
    "reviewed_by",
    "reviewed_at",
    "records_law",
    "rules",
    "request_scopes"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "accessed"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "accessed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]{2}$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "reviewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "$ref": "#/$defs/date"
    },
    "records_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "citation",
        "determination_days",
        "determination_extension_days",
        "day_type",
        "fee_basis",
        "appeal",
        "sources"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "determination_days": {
          "type": "integer",
          "minimum": 1
        },
        "determination_extension_days": {
          "type": "integer",
          "minimum": 0
        },
        "day_type": {
          "enum": [
            "calendar",
            "business"
          ]
        },
        "fee_basis": {
          "type": "string"
        },
        "appeal": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "citation",
          "actor",
          "activity",
          "duty",
          "exceptions",
          "remedy",
          "effective_from",
          "effective_to",
          "sources",
          "review"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z0-9.-]+$"
          },
          "citation": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "duty": {
            "type": "string"
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remedy": {
            "type": "string"
          },
          "effective_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_to": {
            "$ref": "#/$defs/date"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "review": {
            "enum": [
              "verified",
              "likely",
              "needs_attorney_review"
            ]
          }
        }
      }
    },
    "request_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope_id",
          "title",
          "items",
          "rule_ids"
        ],
        "properties": {
          "scope_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
