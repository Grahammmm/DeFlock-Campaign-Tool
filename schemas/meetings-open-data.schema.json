{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/meetings-open-data.schema.json",
  "title": "Meetings open data (public/data/meetings.json)",
  "description": "Only what the meeting pages already show: the meeting, its recorded outcome, votes and official source URLs. Never a comment kit, participation contact, verifier name or note.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "meetings"],
  "properties": {
    "schema_version": {"const": 1},
    "license": {"enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0"]},
    "license_url": {"type": "string", "pattern": "^https://creativecommons.org/"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T00:00:00Z$"},
    "meetings": {"type": "array", "items": {"$ref": "#/$defs/meeting"}}
  },
  "$defs": {
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "body", "agency_id", "starts_at", "status", "agenda_url", "url"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "agency_id": {"type": ["string", "null"]},
        "starts_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["scheduled", "cancelled"]},
        "agenda_url": {"type": ["string", "null"]},
        "url": {"type": "string", "pattern": "^/meetings/.+\\.html$"},
        "outcome": {"$ref": "#/$defs/outcome"}
      }
    },
    "outcome": {
      "description": "Organizer-verified result read from the official record; absent for a cancelled or not yet held meeting.",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "on", "source_url"],
      "properties": {
        "result": {"enum": ["approved", "denied", "continued", "amended", "no_action", "informational"]},
        "on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "source_url": {"type": "string", "pattern": "^https://"},
        "vote": {"type": "string", "minLength": 1},
        "votes": {"type": "array", "items": {"$ref": "#/$defs/vote"}},
        "minutes_url": {"type": "string", "pattern": "^https://", "maxLength": 500},
        "minutes_approved_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      },
      "dependentRequired": {"minutes_url": ["minutes_approved_on"], "minutes_approved_on": ["minutes_url"]}
    },
    "vote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "vote"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "vote": {"enum": ["yes", "no", "abstain", "absent", "recused"]}
      }
    }
  }
}
