{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed agency-card settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "county_profile",
    "source_page",
    "default_fragment",
    "source_aliases",
    "source_link_label"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "county_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "vendor",
        "status",
        "summary",
        "cameraCount",
        "facts",
        "open",
        "flags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "vendor": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "status": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "summary": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "cameraCount": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "facts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 20000,
            "pattern": "^[^<>]*$"
          }
        },
        "open": {
          "type": "string",
          "maxLength": 20000,
          "pattern": "^[^<>]*$"
        },
        "flags": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 20000,
            "pattern": "^[^<>]*$"
          }
        }
      }
    },
    "source_page": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*\\.html$"
    },
    "default_fragment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "source_aliases": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "source_link_label": {
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^<>]*$",
      "minLength": 1
    }
  }
}
