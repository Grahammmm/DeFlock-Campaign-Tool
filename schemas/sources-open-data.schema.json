{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/sources-open-data.schema.json",
  "title": "Source library open data (public/data/sources.json)",
  "description": "Only what sources.html already shows per library entry. Never the private note, the page fragment or a full hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "generated_from", "base_url", "url_kind", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign": {"type": "string", "minLength": 1},
    "generated_from": {"const": "content/sources.json"},
    "base_url": {"type": ["string", "null"]},
    "url_kind": {"enum": ["absolute", "relative"]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256_prefix", "title", "agency_id", "agency_name", "received_at", "public_url", "pages", "cited_by", "public_copy"],
      "properties": {
        "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "title": {"type": "string", "minLength": 1},
        "agency_id": {"type": "string", "minLength": 1},
        "agency_name": {"type": ["string", "null"]},
        "received_at": {"type": "string"},
        "public_url": {"type": ["string", "null"]},
        "pages": {"type": ["integer", "null"], "minimum": 0},
        "cited_by": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}},
        "public_copy": {
          "description": "Organizer check of the linked public copy against the record hash; null when none was recorded.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["matches", "checked_on"],
          "properties": {
            "matches": {"type": "boolean"},
            "checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "reason": {"enum": ["redacted", "converted", "unknown"]}
          }
        }
      }
    }
  }
}
