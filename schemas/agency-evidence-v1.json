{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agency-evidence-v1",
  "title": "Agency evidence row set",
  "description": "One cited agency-evidence-v1 row per agency from tools/agency_verify.py. A verdict is a field decided from the citations alone, never inferred from an agency's name, its county, or a neighbour's verdict.",
  "type": "object",
  "required": ["schema", "review_required", "generated", "limit", "rows", "counts"],
  "properties": {
    "schema": { "const": "agency-evidence-v1" },
    "review_required": { "const": true },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "limit": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/definitions/row" }
    },
    "counts": {
      "type": "object",
      "required": ["agencies", "evidenced", "likely", "no_evidence", "unreachable", "not_checked"],
      "properties": {
        "agencies": { "type": "integer", "minimum": 0 }, "evidenced": { "type": "integer", "minimum": 0 },
        "likely": { "type": "integer", "minimum": 0 }, "no_evidence": { "type": "integer", "minimum": 0 },
        "unreachable": { "type": "integer", "minimum": 0 }, "not_checked": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "row": {
      "type": "object",
      "required": ["agency", "name", "verdict", "citations", "unreachable", "not_checked"],
      "properties": {
        "agency": { "type": "string" },
        "name": { "type": "string" },
        "verdict": { "enum": ["evidenced", "likely", "no-evidence", "unreachable", "not-checked"] },
        "domain": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/definitions/citation" } },
        "unreachable": {
          "type": "array",
          "items": {
            "type": "object", "required": ["url", "reason"],
            "properties": { "url": { "type": "string" }, "reason": { "type": "string" }, "http_status": { "type": ["integer", "null"] } }
          }
        },
        "not_checked": { "type": "array", "items": { "type": "string" } },
        "rejected_quotes": {
          "description": "A quote refused for matching an email/phone/plate pattern: its url and categories only, never the text.",
          "type": "array",
          "items": {
            "type": "object", "required": ["url", "categories"],
            "properties": { "url": { "type": "string" }, "categories": { "type": "array", "items": { "enum": ["email", "phone", "plate"] } } }
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "required": ["url", "fetched_at", "http_status", "content_sha256", "quote", "quote_offset"],
      "properties": {
        "url": { "type": "string" },
        "fetched_at": { "type": "string" },
        "http_status": { "type": "integer" },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "quote": { "type": "string" },
        "quote_offset": { "type": "integer", "minimum": 0 },
        "alpr_terms": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
