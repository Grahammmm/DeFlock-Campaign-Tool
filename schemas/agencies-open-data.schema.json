{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/agencies-open-data.schema.json",
  "title": "Agencies open data (public/data/agencies.json)",
  "description": "Only what an agency's card and page already show, for agencies that have a public page. Never records contacts, portal links, kit data, renewal notes or organizer notes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "generated_from", "base_url", "url_kind", "agencies"],
  "properties": {
    "schema_version": {"const": 1},
    "license": {"enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0"]},
    "license_url": {"type": "string", "pattern": "^https://creativecommons.org/"},
    "campaign": {"type": "string", "minLength": 1},
    "generated_from": {"const": "content/agencies.json"},
    "base_url": {"type": ["string", "null"]},
    "url_kind": {"enum": ["absolute", "relative"]},
    "agencies": {"type": "array", "items": {"$ref": "#/$defs/agency"}}
  },
  "$defs": {
    "agency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agency_id", "name", "kind", "url", "asked", "alpr_policy", "contract", "transparency", "camera_count"],
      "properties": {
        "agency_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "/agencies/.+\\.html$"},
        "asked": {"type": "array", "items": {"$ref": "#/$defs/asked"}},
        "alpr_policy": {"$ref": "#/$defs/policy"},
        "contract": {"$ref": "#/$defs/contract"},
        "transparency": {"$ref": "#/$defs/transparency"},
        "camera_count": {"type": ["string", "null"]}
      }
    },
    "asked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "state", "asked_on", "updated_on"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "state": {"enum": ["awaiting_response", "acknowledged", "partly_answered", "answered", "declined_in_writing", "withdrawn"]},
        "asked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "updated_on": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "policy": {
      "description": "A posted ALPR usage policy an organizer found; linked only, null when none.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url", "checked_on"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "contract": {
      "description": "An organizer-checked contract term from its official source, null when none.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["vendor", "start", "end", "source_url", "checked_on"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "source_url": {"type": "string", "pattern": "^https://"},
        "checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "cost": {"$ref": "#/$defs/cost"}
      }
    },
    "cost": {
      "description": "The amount a contract document states, as the organizer transcribed it; never summed, ranked or divided. Its provenance is the enclosing contract's source_url and checked_on.",
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_usd", "period", "as_stated_in"],
      "properties": {
        "amount_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]*)([.][0-9]{1,2})?$"},
        "period": {"enum": ["annual", "total", "one_time"]},
        "as_stated_in": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "transparency": {
      "description": "The newest organizer-transcribed portal snapshot, only the numbers the page shows; null when none.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source_url", "checked_on"],
      "properties": {
        "cameras": {"type": "integer", "minimum": 0},
        "retention_days": {"type": "integer", "minimum": 0},
        "searches_last_30_days": {"type": "integer", "minimum": 0},
        "hotlist_alerts": {"type": "integer", "minimum": 0},
        "shared_with_agencies": {"type": "integer", "minimum": 0},
        "source_url": {"type": "string", "pattern": "^https://"},
        "checked_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    }
  }
}
