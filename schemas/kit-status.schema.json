{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/kit-status.schema.json",
  "title": "kit-status",
  "description": "Printed by `kit-status` (campaign_tool.kit_track.status): one JSON document on stdout, read-only. requests has one row per recorded hand-sent request, in sent_on then agency_id then request order. Dates are provisional reminders, not legal due dates. more, correspondence, correspondence_prefixes and correspondence_more are conditional: correspondence and correspondence_prefixes appear together only when the request has correspondence records; more and correspondence_more appear only when the list holds more than 50 entries (the prefixes then stop at 50). Nothing is sent or published.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requests", "law_package_status", "note"],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agency_id", "request", "name", "sent_on", "channel", "draft_changed_since_sent",
          "determination_due", "with_extension", "steps", "extended", "closed", "last_step",
          "records", "record_prefixes", "fee_estimate", "over_fee_cap", "stated_production_date",
          "waiting_on_you_since", "producing", "next_installment", "reference", "fee_state", "fee_paid", "withheld_basis", "scopes"
        ],
        "properties": {
          "agency_id": {"type": "string", "minLength": 1},
          "request": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "name": {"type": ["string", "null"]},
          "sent_on": {"$ref": "#/$defs/date"},
          "channel": {"enum": ["email", "portal", "mail", "muckrock"]},
          "draft_changed_since_sent": {"type": "boolean"},
          "determination_due": {"$ref": "#/$defs/date_or_null"},
          "with_extension": {"$ref": "#/$defs/date_or_null"},
          "steps": {"type": "integer", "minimum": 0},
          "extended": {"type": "boolean"},
          "closed": {"type": "boolean"},
          "last_step": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["on", "kind"],
            "properties": {
              "on": {"$ref": "#/$defs/date_or_null"},
              "kind": {
                "enum": ["acknowledged", "extension", "determination", "produced", "denied", "closed",
                         "fee_estimate", "clarification_requested", "clarified", "fee_paid", "fee_waived"]
              }
            }
          },
          "records": {"type": "integer", "minimum": 0},
          "record_prefixes": {"type": "array", "items": {"$ref": "#/$defs/prefix"}},
          "more": {"type": "integer", "minimum": 1},
          "correspondence": {"type": "integer", "minimum": 1},
          "correspondence_prefixes": {"type": "array", "items": {"$ref": "#/$defs/prefix"}},
          "correspondence_more": {"type": "integer", "minimum": 1},
          "fee_estimate": {"$ref": "#/$defs/dollars_or_null"},
          "over_fee_cap": {"type": ["boolean", "null"]},
          "stated_production_date": {"$ref": "#/$defs/date_or_null"},
          "waiting_on_you_since": {"$ref": "#/$defs/date_or_null"},
          "producing": {"type": "boolean"},
          "next_installment": {"$ref": "#/$defs/date_or_null"},
          "reference": {"type": ["string", "null"]},
          "fee_state": {"enum": [null, "unpaid", "paid", "waived"]},
          "fee_paid": {"$ref": "#/$defs/dollars_or_null"},
          "downloads_pending": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["produced_on", "expires_on", "days_left", "state", "line"],
              "properties": {
                "produced_on": {"$ref": "#/$defs/date"},
                "expires_on": {"$ref": "#/$defs/date"},
                "days_left": {"type": "integer"},
                "state": {"enum": ["pending", "expired"]},
                "line": {"type": "string", "minLength": 1}
              }
            }
          },
          "scopes": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope_id", "answer", "on"],
              "properties": {
                "scope_id": {"type": "string", "minLength": 1},
                "answer": {"enum": [null, "produced", "partly_produced", "withheld", "no_records_stated"]},
                "on": {"$ref": "#/$defs/date_or_null"}
              }
            }
          },
          "withheld_basis": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["on", "kind", "basis"],
              "properties": {
                "on": {"$ref": "#/$defs/date_or_null"},
                "kind": {"enum": ["denied", "produced"]},
                "basis": {"type": "string", "minLength": 1, "maxLength": 200}
              }
            }
          }
        }
      }
    },
    "law_package_status": {"enum": ["draft", "reviewed", "missing"]},
    "note": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_or_null": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "dollars_or_null": {"type": ["string", "null"], "pattern": "^\\$[0-9,]+\\.[0-9]{2}$"},
    "prefix": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
  }
}
