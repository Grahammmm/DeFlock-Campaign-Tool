{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deflock-campaign-tool.invalid/schemas/findings-open-data.schema.json",
  "title": "Published findings open data (public/data/findings.json)",
  "description": "Only the fields a published finding page already shows. Never author, state, internal rule fields or full hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign", "generated_from", "base_url", "url_kind", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "license": {"enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0"]},
    "license_url": {"type": "string", "pattern": "^https://creativecommons.org/"},
    "campaign": {"type": "string", "minLength": 1},
    "generated_from": {"const": "content/findings"},
    "base_url": {"type": ["string", "null"]},
    "url_kind": {"enum": ["absolute", "relative"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "summary", "body_md", "classification", "confidence", "event_date",
                   "published_at", "updated_at", "agency_id", "sources", "limitations", "counterevidence",
                   "corrections", "url", "citation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "slug": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "body_md": {"type": "string"},
        "classification": {"enum": ["agency_assertion", "apparent_conflict", "confirmed_conflict", "documented_fact",
                                    "information_gap", "no_conflict", "redaction"]},
        "confidence": {"enum": ["likely", "verified"]},
        "event_date": {"type": "string"},
        "published_at": {"type": "string"},
        "updated_at": {"type": ["string", "null"]},
        "agency_id": {"type": ["string", "null"]},
        "also_agency_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
                            "items": {"type": "string", "pattern": "^[a-z]{2}-[a-z0-9-]{1,80}$"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "counterevidence": {"type": "array", "items": {"type": "string"}},
        "corrections": {"type": "array", "items": {"$ref": "#/$defs/correction"}},
        "updates": {"type": "array", "items": {"$ref": "#/$defs/update"}},
        "url": {"type": "string", "pattern": "^(https?://.+)?/findings/[^/]+\\.html$"},
        "citation": {"type": "string", "minLength": 1},
        "agency_response": {"$ref": "#/$defs/agency_response"}
      }
    },
    "agency_response": {
      "description": "Optional. Present only for a recorded reply (received, declined) or silence (no_response); a prepared but unsent request is never published. Text is the agency's words as written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "asked_on", "reply_by", "on"],
      "properties": {
        "status": {"enum": ["received", "declined", "no_response"]},
        "asked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "reply_by": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "record_sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{12}$"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256_prefix", "title", "locator", "rule_id"],
      "properties": {
        "sha256_prefix": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "title": {"type": "string"},
        "locator": {"type": "string", "minLength": 1},
        "rule_id": {"type": ["string", "null"]},
        "page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "quote": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "update": {
      "description": "Optional list on a finding. New information dated after publication that does not change what the finding says; a correction is listed under corrections instead. Stored order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "note"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "note": {"type": "string", "minLength": 1, "maxLength": 400}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "note"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
