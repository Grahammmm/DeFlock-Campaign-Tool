# PREPARATION ONLY. Do not install alongside a legacy mailbox timer.
[Unit]
Description=Owner-scoped records pipeline schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 07:00:00 America/Los_Angeles
OnCalendar=Mon..Fri *-*-* 15:00:00 America/Los_Angeles
Persistent=true
Unit=@PREPARED_SERVICE_UNIT@

[Install]
WantedBy=timers.target
