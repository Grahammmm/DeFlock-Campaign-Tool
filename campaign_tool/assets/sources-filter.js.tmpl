// Generated by campaign_tool build. Source library filter; the complete grouped list shows without JavaScript.
(function(){var form=document.getElementById("sources-filter");if(!form)return;
var agency=document.getElementById("sources-filter-agency"),year=document.getElementById("sources-filter-year"),
cited=document.getElementById("sources-filter-cited"),count=document.getElementById("sources-filter-count"),
empty=document.getElementById("sources-filter-empty"),els=document.querySelectorAll(".agency-document-group"),
groups=[],total=0,i,rows;
if(!agency||!year||!cited||!count||!empty)return;
for(i=0;i<els.length;i++){rows=els[i].querySelectorAll(".source-table > li.source-entry");total+=rows.length;groups.push({el:els[i],rows:rows});}
function has(s,v){for(var n=0;n<s.options.length;n++)if(s.options[n].value===v)return true;return false;}
function apply(){var a=agency.value,y=year.value,c=cited.checked,shown=0,n,m,r,ok,k;
for(n=0;n<groups.length;n++){k=0;for(m=0;m<groups[n].rows.length;m++){r=groups[n].rows[m];
ok=(a==="all"||r.getAttribute("data-agency")===a)&&(y==="all"||r.getAttribute("data-year")===y)&&(!c||r.getAttribute("data-cited")==="true");
r.hidden=!ok;if(ok)k++;}groups[n].el.hidden=k===0;shown+=k;}
count.textContent=String(LABELS["js.filter_count"]).replace(/\{(shown|total)\}/g,function(x,w){return w==="shown"?shown:total;});
empty.hidden=shown>0;}
function write(){var parts=[];if(agency.value!=="all")parts.push("agency="+encodeURIComponent(agency.value));
if(year.value!=="all")parts.push("year="+encodeURIComponent(year.value));if(cited.checked)parts.push("cited=1");
if(window.history&&window.history.replaceState)window.history.replaceState(null,"",parts.length?"#"+parts.join("&"):location.pathname+location.search);}
function load(){var pairs=location.hash.slice(1).split("&"),a="all",y="all",c=false,found=false,n,p,x,k,v;
for(n=0;n<pairs.length;n++){p=pairs[n];x=p.indexOf("=");k=x<0?p:p.slice(0,x);
if(k!=="agency"&&k!=="year"&&k!=="cited")continue;found=true;if(x<0)continue;
try{v=decodeURIComponent(p.slice(x+1));}catch(err){continue;}
if(k==="agency"&&has(agency,v))a=v;else if(k==="year"&&has(year,v))y=v;else if(k==="cited"&&v==="1")c=true;}
agency.value=a;year.value=y;cited.checked=c;return found;}
function sync(){var found=load();apply();if(found)write();}
form.addEventListener("change",function(){apply();write();});
if(window.addEventListener)window.addEventListener("hashchange",sync);
sync();form.hidden=false;})();
