  function setCityText(slug) {
    var c=slug?CITIES[slug]:{{COUNTY_PROFILE}};
    document.getElementById("city-name").textContent=c.displayName||c.name; document.getElementById("city-vendor").textContent=c.vendor; document.getElementById("city-status").textContent=c.status; document.getElementById("city-summary").textContent=c.summary; document.getElementById("city-camera-count").textContent=c.cameraCount;document.getElementById("city-camera-count").hidden=!c.cameraCount; document.getElementById("city-open").textContent=c.open; var methodLink=document.getElementById("city-method-link"); if(methodLink)methodLink.href={{SOURCE_PREFIX}}+({{SOURCE_ROUTE}}); var sourceLink=document.getElementById("city-records-link"); if(sourceLink){sourceLink.href={{SOURCE_PREFIX}}+({{SOURCE_ROUTE}});sourceLink.textContent={{SOURCE_LINK_LABEL}};}
    var flockLink=document.getElementById("city-flock-link"), flockUrl=typeof c.flockTransparencyUrl==="string"&&/^https:\/\/transparency\.flocksafety\.com\/[a-z0-9-]+$/.test(c.flockTransparencyUrl)?c.flockTransparencyUrl:""; if(flockLink){flockLink.href=flockUrl;flockLink.hidden=!flockUrl;}
    var agencyLink=document.getElementById("city-agency-link"), agencyLabel=agencyLink&&agencyLink.dataset&&typeof agencyLink.dataset.label==="string"?agencyLink.dataset.label:"", agencyPage=agencyLabel&&typeof c.agencyPage==="string"&&/^\/agencies\/[a-z0-9-]+\.html$/.test(c.agencyPage)?c.agencyPage:"", n=c.findingCount, countText=Number.isInteger(n)&&n>=0?(n===0?"no published findings yet":n+" published finding"+(n===1?"":"s")):"";
    if(agencyLink){if(agencyPage){agencyLink.href=agencyPage;agencyLink.textContent=countText?agencyLabel+" \u00b7 "+countText:agencyLabel;agencyLink.hidden=false;}else{if(agencyLink.removeAttribute)agencyLink.removeAttribute("href");else delete agencyLink.href;agencyLink.textContent="";agencyLink.hidden=true;}}
    document.getElementById("city-facts").innerHTML=c.facts.map(function(f){return "<li>"+f+"</li>";}).join(""); document.getElementById("city-flags").innerHTML=c.flags.map(function(f){return "<span>"+f+"</span>";}).join("");
  }
