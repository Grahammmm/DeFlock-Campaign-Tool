// Generated by campaign_tool build. Requests table filter; the complete table shows without JavaScript.
(function(){var form=document.getElementById("requests-filter");if(!form)return;
var agency=document.getElementById("requests-filter-agency"),state=document.getElementById("requests-filter-state"),
count=document.getElementById("requests-filter-count"),empty=document.getElementById("requests-filter-empty"),
table=document.getElementById("requests-table"),tpl=form.getAttribute("data-count-template"),rows;
if(!agency||!state||!count||!empty||!table||tpl===null)return;
rows=table.querySelectorAll("tbody > tr");
if(!rows.length)return;
function has(s,v){for(var n=0;n<s.options.length;n++)if(s.options[n].value===v)return true;return false;}
function apply(){var a=agency.value,t=state.value,shown=0,n,r,ok;
for(n=0;n<rows.length;n++){r=rows[n];
ok=(a==="all"||r.getAttribute("data-agency")===a)&&(t==="all"||r.getAttribute("data-state")===t);
r.hidden=!ok;if(ok)shown++;}
count.textContent=tpl.replace(/\{(shown|total)\}/g,function(x,w){return w==="shown"?shown:rows.length;});
empty.hidden=shown>0;}
function write(){var parts=[];if(agency.value!=="all")parts.push("agency="+encodeURIComponent(agency.value));
if(state.value!=="all")parts.push("state="+encodeURIComponent(state.value));
if(window.history&&window.history.replaceState)window.history.replaceState(null,"",parts.length?"#"+parts.join("&"):location.pathname+location.search);}
function load(){var pairs=location.hash.slice(1).split("&"),a="all",t="all",found=false,n,p,x,k,v;
for(n=0;n<pairs.length;n++){p=pairs[n];x=p.indexOf("=");k=x<0?p:p.slice(0,x);
if(k!=="agency"&&k!=="state")continue;found=true;if(x<0)continue;
try{v=decodeURIComponent(p.slice(x+1));}catch(err){continue;}
if(k==="agency"&&has(agency,v))a=v;else if(k==="state"&&has(state,v))t=v;}
agency.value=a;state.value=t;return found;}
function sync(){var found=load();apply();if(found)write();}
form.addEventListener("submit",function(e){e.preventDefault();});
form.addEventListener("change",function(){apply();write();});
if(window.addEventListener)window.addEventListener("hashchange",sync);
sync();form.hidden=false;})();
