// Generated by campaign_tool build. Meetings body filter; both complete lists show without JavaScript.
(function(){var form=document.getElementById("meetings-filter"),sel=document.getElementById("meetings-filter-body"),
ids=["upcoming","past"],lists=[],tpl,i,k,g,n,c,part;
if(!form||!sel)return;
for(i=0;i<ids.length;i++){g={list:document.getElementById("meetings-filter-"+ids[i]),
count:document.getElementById("meetings-filter-"+ids[i]+"-count"),note:document.getElementById("meetings-filter-"+ids[i]+"-empty"),rows:[]};
part=(g.list?1:0)+(g.count?1:0)+(g.note?1:0);
if(part===3){lists.push(g);}else if(part>0||i===0)return;}
tpl=form.getAttribute("data-count-template");if(typeof tpl!=="string")return;
for(i=0;i<lists.length;i++){c=lists[i].list.children;
for(k=0;k<c.length;k++){if((" "+c[k].className+" ").indexOf(" meeting-filter-item ")>=0)lists[i].rows.push(c[k]);}}
function has(v){for(var m=0;m<sel.options.length;m++)if(sel.options[m].value===v)return true;return false;}
function apply(){var b=sel.value,x,y,r,shown;
for(x=0;x<lists.length;x++){shown=0;
for(y=0;y<lists[x].rows.length;y++){r=lists[x].rows[y];r.hidden=!(b==="all"||r.getAttribute("data-body")===b);if(!r.hidden)shown++;}
lists[x].count.textContent=tpl.replace(/\{(shown|total)\}/g,function(s,w){return w==="shown"?shown:lists[x].rows.length;});
lists[x].note.hidden=shown>0;}}
function write(){var h=sel.value==="all"?location.pathname+location.search:"#body="+encodeURIComponent(sel.value);
if(window.history&&window.history.replaceState)window.history.replaceState(null,"",h);}
function load(){var pairs=location.hash.slice(1).split("&"),b="all",found=false,m,p,q,v;
for(m=0;m<pairs.length;m++){p=pairs[m];q=p.indexOf("=");if(q<0||p.slice(0,q)!=="body")continue;found=true;
try{v=decodeURIComponent(p.slice(q+1));}catch(err){continue;}
if(has(v)&&v!=="all")b=v;}
sel.value=b;return found;}
function sync(){var found=load();apply();if(found)write();}
form.addEventListener("submit",function(ev){ev.preventDefault();});
form.addEventListener("change",function(){apply();write();});
if(window.addEventListener)window.addEventListener("hashchange",sync);
sync();form.hidden=false;
for(n=0;n<lists.length;n++)lists[n].count.hidden=false;})();
