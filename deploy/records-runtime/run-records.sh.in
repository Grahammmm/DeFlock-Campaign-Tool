#!/bin/sh
# Records run wrapper (template; plan T10 + T11). Render every placeholder
# with render.py before installing. The rendered file belongs in the private
# runtime, never in this repository.
#
# Usage: run-records.sh [--target NAME] [--dry-run] [--scheduled | --arrival]
#   --target NAME  stage plan RUNTIME_DIR/targets/NAME.json (default
#                  @DEFAULT_TARGET@); receipts go to RUNTIME_DIR/NAME/
#   --dry-run      print the preflight steps and every stage, then exit;
#                  takes no lock, calls no docker, writes nothing
#   --scheduled    set by the systemd unit; report mode "scheduled"
#                  (a target whose stage plan says mode "test" always
#                  reports mode "test")
#   --arrival      set by records-arrival.service (REC-AUTO-1). Always uses
#                  the SCHEDULED_TARGET plan (a conflicting --target or
#                  --scheduled is a usage error), stamps new files at the
#                  drop folder, and runs the normal incremental stages when
#                  an arrival stamp is pending. No pending work: exit 0
#                  with nothing attempted. Lock busy: write arrival.pending
#                  and exit 0 (not 73); the lock holder drains it with at
#                  most one follow-up arrival run inside the same invocation
#                  deadline. Report mode "arrival".
#
# Exit codes:
#   0      every work stage ok, warn or skipped
#   10-16  first failed work stage: 10 sync, 11 delta, 12 adoption,
#          13 portal, 14 extract, 15 digest_gates, 16 outputs
#   64     usage error
#   (arrival)  0 also means: nothing pending, or the lock was busy and the
#          wake is queued in arrival.pending for the holder to drain
#   70     internal orchestrator error
#   73     another run holds the overlap lock; this slot was skipped
#          (nothing attempted, skip receipt written, no queueing)
#   75     Docker daemon or records container not ready within the bounded
#          readiness deadline (including hung docker commands)
#   78     configuration, identity, image or stage plan check failed, or
#          the runtime filesystem has less than MIN_FREE_BYTES available
#          (or its free space could not be measured)
# A notification failure NEVER changes the exit status. It is logged, an
# alert file is written and the run report carries "notify_failed": true.
# That holds even when the notify helper itself cannot run, hangs, or exits
# without recording an outcome: the wrapper then records the outcome itself.
set -eu
umask 077

RELEASE_COMMIT=@RELEASE_COMMIT@
ENGINE_DIR=@ENGINE_DIR@
DOCKER=@DOCKER@
TIMEOUT=@TIMEOUT@
FLOCK=@FLOCK@
CONTAINER=@CONTAINER@
EXPECTED_IMAGE=@EXPECTED_IMAGE@
RUN_UID=@RUN_UID@
RUNTIME_DIR=@RUNTIME_DIR@
HOST_PYTHON=@HOST_PYTHON@
NOTIFY=@NOTIFY_PY@
NOTIFY_ENV_FILE=@NOTIFY_ENV_FILE@
NOTIFY_LABEL=@NOTIFY_LABEL@
DOCKER_WAIT_ATTEMPTS=@DOCKER_WAIT_ATTEMPTS@
DOCKER_WAIT_DELAY=@DOCKER_WAIT_DELAY@
DOCKER_WAIT_MAX_DELAY=@DOCKER_WAIT_MAX_DELAY@
DOCKER_CMD_TIMEOUT=@DOCKER_CMD_TIMEOUT@
DOCKER_WAIT_DEADLINE=@DOCKER_WAIT_DEADLINE@
NOTIFY_TIMEOUT=@NOTIFY_TIMEOUT@
RUN_BUDGET_SECONDS=@RUN_BUDGET_SECONDS@
MIN_FREE_BYTES=@MIN_FREE_BYTES@
TARGET=@DEFAULT_TARGET@
SCHEDULED_TARGET=@SCHEDULED_TARGET@
RECORDS_DROP_DIR=@RECORDS_DROP_DIR@
# Arrival coalescing: wait for a quiet moment, but never longer than the
# maximum, so a continuous burst cannot push a start past the 2 minute window.
# The two variables are test seams; the cap below bounds any override.
ARRIVAL_QUIET=${ARRIVAL_QUIET_SECONDS:-3}
ARRIVAL_MAX_WAIT=${ARRIVAL_MAX_WAIT_SECONDS:-30}
# Internal follow-up guard (never a public mode): set only by this script.
FOLLOWUP=${RECORDS_ARRIVAL_FOLLOWUP:-0}
INVOCATION_DEADLINE=${RECORDS_INVOCATION_DEADLINE:-0}
# Grace between TERM and KILL for a timed-out command.
KILL_AFTER=2
# Deadline for the free-space probe (df), so a hung filesystem cannot stall.
DF_TIMEOUT=10
# Extra time the orchestrator gets past its own deadline before the
# backstop timeout signals it (it then writes RUN_INTERRUPTED and exits).
BACKSTOP_GRACE=15

usage() {
  printf '%s\n' "usage: run-records.sh [--target NAME] [--dry-run] [--scheduled | --arrival]" >&2
  exit 64
}

DRY_RUN=0
SCHEDULED=0
ARRIVAL=0
TARGET_EXPLICIT=0
while [ $# -gt 0 ]; do
  case "$1" in
    --target) [ $# -ge 2 ] || usage; TARGET=$2; TARGET_EXPLICIT=1; shift 2;;
    --target=*) TARGET=${1#--target=}; TARGET_EXPLICIT=1; shift;;
    --dry-run) DRY_RUN=1; shift;;
    --scheduled) SCHEDULED=1; shift;;
    --arrival) ARRIVAL=1; shift;;
    *) usage;;
  esac
done
if [ "$ARRIVAL" -eq 1 ]; then
  [ "$SCHEDULED" -eq 0 ] || usage
  [ "$TARGET_EXPLICIT" -eq 0 ] || [ "$TARGET" = "$SCHEDULED_TARGET" ] || usage
  TARGET=$SCHEDULED_TARGET
fi
[ "$ARRIVAL" -eq 1 ] || [ "$FOLLOWUP" -eq 0 ] || usage
case "$TARGET" in ""|[!A-Z]*|*[!A-Z0-9_]*) usage;; esac
[ "${#TARGET}" -le 32 ] || usage

# Static preflight. A refusal is noted (code only) in a private receipt
# line when RUNTIME_DIR exists, because the unit discards stderr.
refuse() {
  printf '%s\n' "run-records: refused ($1); nothing attempted" >&2
  if [ -d "$RUNTIME_DIR" ]; then
    printf '%s target=%s refused=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$TARGET" "$1" \
      >>"$RUNTIME_DIR/preflight-refusals.log" 2>/dev/null || :
  fi
  exit 78
}
case "$RELEASE_COMMIT" in *[!0-9a-f]*|"") refuse RELEASE_COMMIT_INVALID;; esac
[ "${#RELEASE_COMMIT}" -eq 40 ] || refuse RELEASE_COMMIT_INVALID
[ "$(id -u)" -eq "$RUN_UID" ] || refuse RUN_UID_MISMATCH
for n in "$DOCKER_WAIT_ATTEMPTS" "$DOCKER_WAIT_DELAY" "$DOCKER_WAIT_MAX_DELAY" \
    "$DOCKER_CMD_TIMEOUT" "$DOCKER_WAIT_DEADLINE" "$NOTIFY_TIMEOUT" "$RUN_BUDGET_SECONDS" \
    "$MIN_FREE_BYTES"; do
  case "$n" in *[!0-9]*|"") refuse NUMBER_INVALID;; esac
done
# Canonical decimal only (no leading zero) and never 0: the check cannot be
# disabled by a value that reads as "off".
case "$MIN_FREE_BYTES" in 0*) refuse NUMBER_INVALID;; esac
[ "$DOCKER_WAIT_ATTEMPTS" -ge 1 ] || refuse NUMBER_INVALID
[ "$DOCKER_CMD_TIMEOUT" -ge 1 ] || refuse NUMBER_INVALID
[ "$DOCKER_WAIT_DEADLINE" -ge 1 ] || refuse NUMBER_INVALID
[ "$NOTIFY_TIMEOUT" -ge 1 ] || refuse NUMBER_INVALID
[ "$RUN_BUDGET_SECONDS" -gt "$DOCKER_WAIT_DEADLINE" ] || refuse NUMBER_INVALID
[ -x "$TIMEOUT" ] || refuse TIMEOUT_MISSING
[ -x "$FLOCK" ] || refuse FLOCK_MISSING
[ -x "$HOST_PYTHON" ] || refuse HOST_PYTHON_MISSING
[ -f "$ENGINE_DIR/campaign_tool/records/run_orchestrator.py" ] || refuse ENGINE_DIR_INVALID
case "$RECORDS_DROP_DIR" in /*) ;; *) refuse DROP_DIR_INVALID;; esac
for n in "$ARRIVAL_QUIET" "$ARRIVAL_MAX_WAIT" "$INVOCATION_DEADLINE"; do
  case "$n" in *[!0-9]*|"") refuse NUMBER_INVALID;; esac
done
case "$FOLLOWUP" in 0) ;; 1) [ "$INVOCATION_DEADLINE" -gt 0 ] || refuse NUMBER_INVALID;; *) refuse NUMBER_INVALID;; esac
[ "$ARRIVAL_MAX_WAIT" -le 60 ] || ARRIVAL_MAX_WAIT=60
TARGET_CONFIG="$RUNTIME_DIR/targets/$TARGET.json"
[ -f "$TARGET_CONFIG" ] || refuse TARGET_CONFIG_MISSING

orch() {
  PYTHONPATH="$ENGINE_DIR" "$HOST_PYTHON" -B -m campaign_tool.records.run_orchestrator "$@"
}

arr() {
  PYTHONPATH="$ENGINE_DIR" "$HOST_PYTHON" -B -m campaign_tool.records.arrival "$@" </dev/null 9>&-
}

if [ "$DRY_RUN" -eq 1 ]; then
  printf '%s\n' "dry-run target=$TARGET: nothing is executed, locked or written"
  printf '%s\n' "preflight 1 lock: $RUNTIME_DIR/run-records.lock (held by another run: skip, exit 73)"
  printf '%s\n' "preflight 2 disk: $RUNTIME_DIR filesystem needs at least $MIN_FREE_BYTES bytes available (else exit 78)"
  printf '%s\n' "preflight 3 docker: wait up to $DOCKER_WAIT_ATTEMPTS attempts / ${DOCKER_WAIT_DEADLINE}s for daemon and container (else exit 75)"
  printf '%s\n' "preflight 4 image: container image must equal the pinned image (else exit 78)"
  printf '%s\n' "budget: ${RUN_BUDGET_SECONDS}s from start for all work stages; notify ${NOTIFY_TIMEOUT}s"
  if [ "$ARRIVAL" -eq 1 ]; then
    printf '%s\n' "arrival: target $TARGET (SCHEDULED_TARGET); watched: drop folder $RECORDS_DROP_DIR and $RUNTIME_DIR/arrival/"
    printf '%s\n' "arrival: no pending stamps and no drop change: exit 0 without docker, report or notify"
    printf '%s\n' "arrival: lock busy: write $RUNTIME_DIR/arrival.pending, exit 0 (not 73), never interrupt the holder"
    printf '%s\n' "arrival: the finishing holder drains pending with at most one follow-up arrival run inside the same invocation deadline"
  fi
  orch plan --target-config "$TARGET_CONFIG"
  exit $?
fi

START_EPOCH=$(date +%s)
# One absolute deadline per systemd invocation, shared by the first run and
# its single follow-up, so the follow-up can never double the unit timeout.
INVOCATION_DEADLINE_USE=$((START_EPOCH + RUN_BUDGET_SECONDS))
if [ "$FOLLOWUP" -eq 1 ] && [ "$INVOCATION_DEADLINE" -lt "$INVOCATION_DEADLINE_USE" ]; then
  INVOCATION_DEADLINE_USE=$INVOCATION_DEADLINE
fi
# A follow-up must fit the worst-case docker readiness plus a minute of work.
FOLLOWUP_MIN_SECONDS=$((DF_TIMEOUT + KILL_AFTER + DOCKER_WAIT_DEADLINE + 3 * (DOCKER_CMD_TIMEOUT + KILL_AFTER) + 60))
STARTED_AT=$(date -u -d "@$START_EPOCH" +%Y-%m-%dT%H:%M:%SZ)
RUN_ID="run_$(date -u -d "@$START_EPOCH" +%Y%m%dT%H%M%SZ)_$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
TARGET_DIR="$RUNTIME_DIR/$TARGET"
mkdir -p "$TARGET_DIR/reports" "$TARGET_DIR/alerts" "$TARGET_DIR/work"
LOG="$TARGET_DIR/run-records.log"
REPORT="$TARGET_DIR/reports/$RUN_ID.json"
SCHED_FLAG=
[ "$SCHEDULED" -eq 0 ] || SCHED_FLAG=--scheduled
[ "$ARRIVAL" -eq 0 ] || SCHED_FLAG=--arrival
ARRIVALS_FILE=

log() {
  # The file append is never fatal: on a full disk it can fail, and the run
  # must still reach its own exit code (78 for the free-space preflight).
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) run=$RUN_ID $*"
  printf '%s\n' "$line" >>"$LOG" 2>/dev/null || :
  printf '%s\n' "$line" >&2
}

# Arrival prelude (REC-AUTO-1). Stamp completed files at the drop folder,
# then do nothing at all when no stamp is pending. Coalesce a burst with a
# bounded quiet wait; the cap keeps every start inside the 2 minute window.
if [ "$ARRIVAL" -eq 1 ] && [ "$FOLLOWUP" -eq 0 ]; then
  # Rescan inside the same bounded wake while files are still settling or the
  # capped scan has not covered the whole folder; a freshly renamed file has
  # no second PathChanged event to wake us again.
  scan_deadline=$(( $(date +%s) + ARRIVAL_MAX_WAIT ))
  while :; do
    if ! scan_out=$(arr scan-drop --runtime-dir "$RUNTIME_DIR" --drop-dir "$RECORDS_DROP_DIR"); then
      refuse ARRIVAL_SCAN_FAILED
    fi
    case "$scan_out" in
      *"unsettled=0 more=0") break ;;
    esac
    [ "$(date +%s)" -lt "$scan_deadline" ] || break
    case "$scan_out" in
      *"more=1") ;;
      *) sleep 1 ;;
    esac
  done
  set +e
  arr has-work --stamps-only --runtime-dir "$RUNTIME_DIR"
  hw=$?
  set -e
  [ "$hw" -ne 2 ] || refuse ARRIVAL_STATE_INVALID
  [ "$hw" -eq 0 ] || exit 0
  waited=0
  sig=$(arr list --runtime-dir "$RUNTIME_DIR") || refuse ARRIVAL_STATE_INVALID
  while [ "$ARRIVAL_QUIET" -gt 0 ] && [ "$waited" -lt "$ARRIVAL_MAX_WAIT" ]; do
    sleep "$ARRIVAL_QUIET"
    waited=$((waited + ARRIVAL_QUIET))
    now_sig=$(arr list --runtime-dir "$RUNTIME_DIR") || refuse ARRIVAL_STATE_INVALID
    [ "$now_sig" != "$sig" ] || break
    sig=$now_sig
  done
fi

# Overlap lock (plan T11): one records run at a time per runtime, across all
# targets and triggers. A scheduled or manual slot that finds the lock held is
# skipped, not queued. An arrival that finds it held writes arrival.pending
# for the holder to drain and exits 0. The running run is never interrupted.
# flock releases on process exit. The one follow-up run inherits fd 9: flock
# on the same open file description succeeds, so the lock is never released
# between the two runs and a second open file description is never created.
[ "$FOLLOWUP" -eq 1 ] || exec 9>>"$RUNTIME_DIR/run-records.lock"
if ! "$FLOCK" -n 9; then
  if [ "$ARRIVAL" -eq 1 ]; then
    if arr mark-pending --runtime-dir "$RUNTIME_DIR"; then
      log "arrival queued: another records run holds the lock; pending marker written"
      exit 0
    fi
    log "ERROR: arrival could not record its pending marker"
    exit 78
  fi
  log "skipped: another records run holds the lock; nothing attempted"
  skip="$TARGET_DIR/alerts/run-skipped-$RUN_ID.json"
  printf '{"schema":"records-run-skipped-v1","kind":"lock_held","run_id":"%s","target":"%s","at":"%s"}\n' \
    "$RUN_ID" "$TARGET" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$skip.tmp" && mv -f "$skip.tmp" "$skip" ||
    log "could not write skip receipt"
  exit 73
fi

# Run one docker command under a hard deadline. GNU timeout puts the command
# in its own process group and signals the whole group, so a hung client and
# anything it spawned are terminated. stdin is closed.
dcmd() {
  "$TIMEOUT" -k "$KILL_AFTER" "$DOCKER_CMD_TIMEOUT" "$DOCKER" "$@" </dev/null
}

docker_ready() {
  dcmd info >/dev/null 2>&1 || return 1
  [ "$(dcmd inspect --format '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = true ]
}

# Bounded wait for rootless Docker and the records container (Oct 17: the
# timer fired after reboot before the rootless daemon was up). Bounded by
# both an attempt count and an overall wall-clock deadline; every docker call
# also has its own deadline, so a hung daemon cannot stall the run.
DOCKER_ATTEMPTS_USED=0
WAIT_STARTED=$(date +%s)
deadline_left() {
  echo $((WAIT_STARTED + DOCKER_WAIT_DEADLINE - $(date +%s)))
}
wait_for_docker() {
  delay="$DOCKER_WAIT_DELAY"
  attempt=1
  while :; do
    DOCKER_ATTEMPTS_USED=$attempt
    if docker_ready; then
      return 0
    fi
    if [ "$attempt" -ge "$DOCKER_WAIT_ATTEMPTS" ]; then
      return 1
    fi
    left=$(deadline_left)
    if [ "$left" -le 0 ]; then
      log "docker not ready (attempt $attempt/$DOCKER_WAIT_ATTEMPTS); readiness deadline ${DOCKER_WAIT_DEADLINE}s reached"
      return 1
    fi
    [ "$delay" -le "$left" ] || delay="$left"
    log "docker not ready (attempt $attempt/$DOCKER_WAIT_ATTEMPTS); retrying in ${delay}s"
    sleep "$delay"
    attempt=$((attempt + 1))
    delay=$((delay * 2))
    [ "$delay" -le "$DOCKER_WAIT_MAX_DELAY" ] || delay="$DOCKER_WAIT_MAX_DELAY"
  done
}

# Free-space preflight (Fable audit F4(a)). Prints the bytes available to
# this (non-root) user on the filesystem holding $1, or nothing when that
# cannot be measured. POSIX `df -P -k`: Available is the field before the
# Capacity (NN%) field, which tolerates spaces in the device name. df runs
# under its own deadline so a hung filesystem cannot stall the slot. The probe
# output is captured on its own (not piped) so a df failure or timeout is seen
# even when it printed a plausible line first; any nonzero status is unknown.
available_bytes() {
  df_out=$("$TIMEOUT" -k "$KILL_AFTER" "$DF_TIMEOUT" df -P -k "$1" </dev/null 2>/dev/null) ||
    return 0
  kib=$(printf '%s\n' "$df_out" |
    awk 'NR == 2 { for (i = 5; i <= NF; i++) if ($i ~ /^[0-9]+%$/) { print $(i - 1); exit } }')
  case "$kib" in ""|*[!0-9]*) return 0;; esac
  # Strip leading zeros so shell arithmetic never reads the value as octal.
  while [ "${#kib}" -gt 1 ] && [ "${kib#0}" != "$kib" ]; do kib=${kib#0}; done
  # More than 15 digits (about 1 EiB) is not a real reading; refuse to guess.
  [ "${#kib}" -le 15 ] || return 0
  printf '%s\n' "$((kib * 1024))"
}

RUN_EXIT=0
abort_report() {
  # $1 reason code. Writes a schema-valid report: sync failed with the code,
  # every later stage skipped, a blocking needs-G item.
  orch abort --run-id "$RUN_ID" --started-at "$STARTED_AT" \
    --target-config "$TARGET_CONFIG" $SCHED_FLAG ${ARRIVALS_FILE:+--arrivals-file "$ARRIVALS_FILE"} \
    --reason "$1" --report "$REPORT" ||
    log "could not write abort report"
}

alert_without_report() {
  # Last resort when even the orchestrator cannot record the notify outcome.
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  alert="$TARGET_DIR/alerts/notify-failed-$RUN_ID.json"
  printf '{"schema":"records-notify-alert-v1","kind":"notify_failed","run_id":"%s","run_overall_status":"unknown","run_exit_code":%s,"reason":"%s","at":"%s"}\n' \
    "$RUN_ID" "$RUN_EXIT" "$1" "$at" >"$alert.tmp" 2>/dev/null &&
    mv -f "$alert.tmp" "$alert" || log "notify: could not write alert file"
}

notify_fallback() {
  # $1 reason enum, $2 optional --only-if-pending. Independent of notify.py:
  # used when the helper could not run, failed, hung or left no outcome.
  orch notify-fallback --report "$REPORT" --alerts-dir "$TARGET_DIR/alerts" \
    --reason "$1" --exit-code "$RUN_EXIT" ${2:-}
  frc=$?
  if [ "$frc" -eq 3 ]; then
    return 0
  fi
  log "notify: FAILED reason=$1; run status unchanged"
  if [ "$frc" -ne 0 ]; then
    log "notify: could not update run report"
    alert_without_report "$1"
  fi
}

notify() {
  # Never fatal (Oct 16 regression). Every path below returns 0.
  set +e
  PYTHONPATH="$ENGINE_DIR" "$TIMEOUT" -k "$KILL_AFTER" "$NOTIFY_TIMEOUT" \
    "$HOST_PYTHON" -B "$NOTIFY" --report "$REPORT" --alerts-dir "$TARGET_DIR/alerts" \
    --exit-code "$RUN_EXIT" --log "$LOG" --env-file "$NOTIFY_ENV_FILE" \
    --label "$NOTIFY_LABEL" </dev/null 9>&-
  nrc=$?
  if [ "$nrc" -eq 124 ] || [ "$nrc" -eq 137 ]; then
    notify_fallback helper_timeout
  elif [ "$nrc" -ne 0 ]; then
    notify_fallback helper_failed
  else
    # Helper exited 0; make sure it actually recorded an outcome.
    notify_fallback helper_no_outcome --only-if-pending
  fi
  cp -f "$REPORT" "$TARGET_DIR/run-report.json.tmp" 2>/dev/null &&
    mv -f "$TARGET_DIR/run-report.json.tmp" "$TARGET_DIR/run-report.json" ||
    log "notify: could not publish run-report.json"
  set -e
  return 0
}

# Drain (REC-AUTO-1). Runs after this run's own report and notify are final,
# while fd 9 still holds the records lock. A stamp that arrived at any point
# before this check is pending and is claimed by the one follow-up; a stamp
# that arrives after it stays pending and wakes the path unit afresh, so a
# merged systemd activation cannot lose it. Only a run that attempted its
# work drains (no retry loop after a preflight failure), and the follow-up
# never drains again.
drain() {
  [ "$FOLLOWUP" -eq 0 ] || return 0
  case "$1" in 0|1[0-6]) ;; *) return 0;; esac
  set +e
  arr scan-drop --runtime-dir "$RUNTIME_DIR" --drop-dir "$RECORDS_DROP_DIR"
  arr has-work --stamps-only --runtime-dir "$RUNTIME_DIR"
  hw=$?
  set -e
  [ "$hw" -eq 0 ] || return 0
  left=$((INVOCATION_DEADLINE_USE - $(date +%s)))
  if [ "$left" -lt "$FOLLOWUP_MIN_SECONDS" ]; then
    log "ARRIVAL_FOLLOWUP_DEFERRED: ${left}s left of the invocation deadline; arrivals stay pending"
    return 0
  fi
  # Clear the marker before the follow-up so later events are never erased.
  set +e
  arr take-pending --runtime-dir "$RUNTIME_DIR"
  log "starting one arrival follow-up run"
  RECORDS_ARRIVAL_FOLLOWUP=1 RECORDS_INVOCATION_DEADLINE="$INVOCATION_DEADLINE_USE" \
    /bin/sh "$0" --arrival </dev/null
  frc=$?
  [ "$frc" -eq 0 ] || log "arrival follow-up exited rc=$frc; this run's exit status is unchanged"
  set -e
  return 0
}

finish() {
  # $1 exit code
  RUN_EXIT=$1
  log "finished exit=$1"
  notify
  if [ "$ARRIVAL" -eq 1 ]; then
    case "$1" in
      0|1[0-6]) ;;
      *) # abnormal end: keep the queued wake visible, never consume
        set +e
        arr has-work --stamps-only --runtime-dir "$RUNTIME_DIR" && arr mark-pending --runtime-dir "$RUNTIME_DIR"
        set -e;;
    esac
  fi
  drain "$1"
  exit "$1"
}

log "started target=$TARGET"
set +e
orch check --target-config "$TARGET_CONFIG"
crc=$?
set -e
if [ "$crc" -ne 0 ]; then
  log "ERROR: stage plan for target $TARGET is invalid; no records work was attempted"
  abort_report TARGET_CONFIG_INVALID
  finish 78
fi
# Free-space preflight: refuse before any records work (and before the
# per-run backup) rather than fail every slot half-way on a full disk.
FREE_BYTES=$(available_bytes "$RUNTIME_DIR")
if [ -z "$FREE_BYTES" ]; then
  log "ERROR: could not measure free space on the runtime filesystem; no records work was attempted"
  abort_report DISK_SPACE_UNKNOWN
  finish 78
fi
if [ "$FREE_BYTES" -lt "$MIN_FREE_BYTES" ]; then
  log "ERROR: runtime filesystem has $FREE_BYTES bytes available, below MIN_FREE_BYTES=$MIN_FREE_BYTES; no records work was attempted"
  abort_report DISK_SPACE_LOW
  finish 78
fi
log "disk ok: $FREE_BYTES bytes available (minimum $MIN_FREE_BYTES)"
if ! wait_for_docker; then
  log "ERROR: Docker daemon or container '$CONTAINER' not ready after $DOCKER_ATTEMPTS_USED/$DOCKER_WAIT_ATTEMPTS attempts (deadline ${DOCKER_WAIT_DEADLINE}s, per-command ${DOCKER_CMD_TIMEOUT}s); no records work was attempted"
  abort_report DOCKER_UNAVAILABLE
  finish 75
fi
log "docker ready after $DOCKER_ATTEMPTS_USED/$DOCKER_WAIT_ATTEMPTS attempts"
set +e
image="$(dcmd inspect --format '{{.Image}}' "$CONTAINER" 2>/dev/null)"
irc=$?
set -e
if [ "$irc" -ne 0 ]; then
  log "ERROR: docker inspect of container '$CONTAINER' failed or timed out (rc=$irc); no records work was attempted"
  abort_report DOCKER_UNAVAILABLE
  finish 75
fi
if [ "$image" != "$EXPECTED_IMAGE" ]; then
  log "ERROR: container image does not match the pinned image; no records work was attempted"
  abort_report IMAGE_MISMATCH
  finish 78
fi

# Arrival batch: claimed only now, after the lock, plan, disk and image
# preflights, so an early abort never consumes a stamp. The same immutable
# batch then goes to the normal, failure and notify-fallback reports.
if [ "$ARRIVAL" -eq 1 ]; then
  set +e
  arr has-work --stamps-only --runtime-dir "$RUNTIME_DIR"
  hw=$?
  set -e
  if [ "$hw" -eq 1 ]; then
    log "arrival: nothing pending any more; nothing attempted"
    exit 0
  fi
  ARRIVALS_FILE="$TARGET_DIR/work/arrivals-$RUN_ID.json"
  if ! arr claim --runtime-dir "$RUNTIME_DIR" --run-id "$RUN_ID" --out "$ARRIVALS_FILE"; then
    ARRIVALS_FILE=
    log "ERROR: arrival batch could not be claimed; no records work was attempted"
    abort_report ARRIVAL_STATE_INVALID
    finish 78
  fi
fi

# Work stages. The orchestrator owns per-stage timeouts and the overall
# deadline (RUN_BUDGET_SECONDS from START_EPOCH, so the Docker wait counts).
# GNU timeout is only a backstop: on its TERM the orchestrator records
# RUN_INTERRUPTED and still writes the report. Stage stdout/stderr never
# reach this log.
DEADLINE_EPOCH=$INVOCATION_DEADLINE_USE
BACKSTOP=$((DEADLINE_EPOCH - $(date +%s) + BACKSTOP_GRACE))
[ "$BACKSTOP" -ge 1 ] || BACKSTOP=1
set +e
"$TIMEOUT" -k "$KILL_AFTER" "$BACKSTOP" env PYTHONPATH="$ENGINE_DIR" \
  "$HOST_PYTHON" -B -m campaign_tool.records.run_orchestrator run \
  --target-config "$TARGET_CONFIG" --expect-target "$TARGET" --run-id "$RUN_ID" \
  --started-at "$STARTED_AT" --deadline-epoch "$DEADLINE_EPOCH" --report "$REPORT" \
  --work-dir "$TARGET_DIR/work" $SCHED_FLAG ${ARRIVALS_FILE:+--arrivals-file "$ARRIVALS_FILE"} </dev/null 9>&-
rc=$?
set -e
if [ ! -f "$REPORT" ]; then
  log "ERROR: orchestrator exited rc=$rc without a run report"
  abort_report ORCHESTRATOR_FAILED
  finish 70
fi
case "$rc" in
  0|1[0-6]|70|78) finish "$rc";;
  *) log "ERROR: orchestrator exited with unexpected rc=$rc"; finish 70;;
esac
