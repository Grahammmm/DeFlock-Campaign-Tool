    "-v",
    "@PORTAL_APPROVAL_FILE@:/run/flock-portal-approval.json:ro",
    "-e",
    "PYTHONPATH=/engine",
    "@EXPECTED_IMAGE@",
    "python3",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "portal",
    "--project",
    "/workspace/flockbot/work/records-project",
    "--timeout",
    "290",
    "--run-id",
    "{run_id}",
    "--approval-file",
    "/run/flock-portal-approval.json"
   ],
   "timeout_seconds": 300,
   "on_fail": "continue"
  },
