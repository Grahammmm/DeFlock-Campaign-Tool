    "-v",
    "@PORTAL_APPROVAL_FILE@:/run/flock-portal-approval.json:ro",
    "-e",
    "PYTHONPATH=/engine",
    "@EXPECTED_IMAGE@",
    "python3",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "adoption",
    "--project",
    "/workspace/flockbot/work/records-project",
    "--timeout",
    "890",
    "--run-id",
    "{run_id}",
    "--config",
    "/workspace/flockbot/work/records-project/.t4-adoption-config-v1.json"
   ],
   "timeout_seconds": 900,
   "on_fail": "continue"
  },
  {
   "name": "portal",
   "argv": [
    "@DOCKER@",
    "run",
    "--rm",
    "--network",
    "none",
    "--user",
    "@SANDBOX_USER@",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "-v",
