{
 "target_config_version": 1,
 "target": "@TARGET_NAME@",
 "mode": "test",
 "stages": [
  {
   "name": "sync",
   "argv": [
    "@DOCKER@",
    "run",
    "--rm",
    "--network",
    "none",
    "--user",
    "@SANDBOX_USER@",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "-v",
    "@SANDBOX_PROJECT_DIR@:/workspace/flockbot/work/records-project",
    "-v",
    "@SANDBOX_ENGINE_DIR@:/engine:ro",
    "-v",
    "@PORTAL_APPROVAL_FILE@:/run/flock-portal-approval.json:ro",
    "-e",
    "PYTHONPATH=/engine",
    "@EXPECTED_IMAGE@",
    "python3",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "sync",
    "--project",
    "/workspace/flockbot/work/records-project",
    "--timeout",
    "110",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 120,
   "on_fail": "stop"
  },
  {
   "name": "delta",
   "argv": [
    "@DOCKER@",
    "run",
    "--rm",
    "--network",
    "none",
    "--user",
    "@SANDBOX_USER@",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "-v",
    "@SANDBOX_PROJECT_DIR@:/workspace/flockbot/work/records-project",
    "-v",
    "@SANDBOX_ENGINE_DIR@:/engine:ro",
    "-v",
    "@PORTAL_APPROVAL_FILE@:/run/flock-portal-approval.json:ro",
    "-e",
    "PYTHONPATH=/engine",
    "@EXPECTED_IMAGE@",
    "python3",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "delta",
    "--project",
    "/workspace/flockbot/work/records-project",
    "--timeout",
    "590",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 600,
   "on_fail": "stop"
  },
  {
   "name": "adoption",
   "argv": [
    "@DOCKER@",
    "run",
    "--rm",
    "--network",
    "none",
    "--user",
    "@SANDBOX_USER@",
    "--cap-drop",
    "ALL",
