    "-v",
    "@SANDBOX_ENGINE_DIR@:/engine:ro",
    "-v",
    "@PORTAL_APPROVAL_FILE@:/run/flock-portal-approval.json:ro",
    "-e",
    "PYTHONPATH=/engine",
    "@EXPECTED_IMAGE@",
    "python3",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "digest_gates",
    "--project",
    "/workspace/flockbot/work/records-project",
    "--timeout",
    "110",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 120,
   "on_fail": "stop"
  },
  {
   "name": "outputs",
   "argv": [
    "@DOCKER@",
    "run",
    "--rm",
    "--network",
    "none",
    "--user",
