{
 "target_config_version": 1,
 "target": "@TARGET_NAME@",
 "mode": "test",
 "stages": [
  {
   "name": "sync",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "sync",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "110",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 120,
   "on_fail": "stop"
  },
  {
   "name": "delta",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "delta",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "590",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 600,
   "on_fail": "stop"
  },
  {
   "name": "adoption",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "adoption",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "890",
    "--run-id",
    "{run_id}",
    "--config",
    "@ADOPTION_CONFIG@"
   ],
   "timeout_seconds": 900,
   "on_fail": "continue"
  },
  {
   "name": "portal",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "portal",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "290",
    "--run-id",
    "{run_id}",
    "--approval-file",
    "@CONTAINER_APPROVAL_FILE@"
   ],
   "timeout_seconds": 300,
   "on_fail": "continue"
  },
  {
   "name": "extract",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "extract",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "590",
    "--run-id",
    "{run_id}",
    "--max-documents",
    "200",
    "--document-timeout",
    "120"
   ],
   "timeout_seconds": 600,
   "on_fail": "stop"
  },
  {
   "name": "digest_gates",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "digest_gates",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "110",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 120,
   "on_fail": "stop"
  },
  {
   "name": "outputs",
   "argv": [
    "@DOCKER@",
    "exec",
    "-u",
    "@CONTAINER_USER@",
    "@CONTAINER@",
    "env",
    "PYTHONPATH=@CONTAINER_ENGINE_DIR@",
    "@CONTAINER_PYTHON@",
    "-B",
    "-m",
    "campaign_tool.records.run_stages",
    "outputs",
    "--project",
    "@CONTAINER_PROJECT_DIR@",
    "--timeout",
    "110",
    "--run-id",
    "{run_id}"
   ],
   "timeout_seconds": 120,
   "on_fail": "stop"
  }
 ]
}
