[Unit]
Description=DeFlock local schedule: status --check (read-only re-hash against the ledger)
# Gate-safe slot. Exit 3 (a ledger problem) marks the unit failed: that failed unit is the alert.

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
UMask=0077
# Per-slot overlap lock: a held lock skips this slot with exit 73, never queues.
ExecStart=/usr/bin/flock -n -E 73 %t/deflock-reconcile.lock @PYTHON@ -B -m campaign_tool status --check --directory @STORE@
TimeoutStartSec=40min
