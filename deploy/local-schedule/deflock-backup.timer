[Unit]
Description=DeFlock local schedule: backup daily

[Timer]
# 03:00 America/Los_Angeles, daily, weekends included (a local tar; it also protects state written by weekday jobs). Runs before the first records slot.
OnCalendar=*-*-* 03:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=5min
Unit=deflock-backup.service

[Install]
WantedBy=timers.target
