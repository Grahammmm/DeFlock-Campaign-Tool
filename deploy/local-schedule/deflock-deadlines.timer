[Unit]
Description=DeFlock local schedule: deadlines weekdays

[Timer]
# 09:00 America/Los_Angeles, weekdays only, two hours after the 07:00 records run. Drafts only. The rule is checked as of the run date, so Monday catches deadlines that fell on a weekend (calendar days are still counted).
OnCalendar=Mon..Fri *-*-* 09:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=5min
Unit=deflock-deadlines.service

[Install]
WantedBy=timers.target
