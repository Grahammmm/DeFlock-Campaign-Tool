[Unit]
Description=DeFlock local schedule: verified local backup tar
# Gate-safe slot. Local tar only (no upload); %h/deflock-backups must exist as a private 0700 folder.

[Service]
Type=oneshot
WorkingDirectory=@WORKDIR@
UMask=0077
# Per-slot overlap lock: a held lock skips this slot with exit 73, never queues.
ExecStart=/usr/bin/flock -n -E 73 %t/deflock-backup.lock @PYTHON@ -B -m campaign_tool backup --directory @STORE@ --into %h/deflock-backups
TimeoutStartSec=40min
