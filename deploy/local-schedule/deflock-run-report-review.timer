[Unit]
Description=DeFlock local schedule: run-report-review weekdays

[Timer]
# 16:00 America/Los_Angeles, weekdays only, one hour after the 15:00 records run, so it summarises that run.
OnCalendar=Mon..Fri *-*-* 16:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=5min
Unit=deflock-run-report-review.service

[Install]
WantedBy=timers.target
