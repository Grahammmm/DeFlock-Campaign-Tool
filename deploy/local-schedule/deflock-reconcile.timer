[Unit]
Description=DeFlock local schedule: reconcile weekdays

[Timer]
# 10:00 America/Los_Angeles, weekdays only. After the 07:00 records run and the 09:00 deadline drafts, so it checks the state they left. Nothing changes over a weekend.
OnCalendar=Mon..Fri *-*-* 10:00:00 America/Los_Angeles
Persistent=true
RandomizedDelaySec=5min
Unit=deflock-reconcile.service

[Install]
WantedBy=timers.target
