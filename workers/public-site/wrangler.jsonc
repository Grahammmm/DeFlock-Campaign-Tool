// Public site Worker: static files from R2 sites/<version>/ with the site's _headers CSP.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deflock-public-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "r2_buckets": [{ "binding": "PUBLIC_BUCKET", "bucket_name": "example-campaign-public" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "local" }]
}
